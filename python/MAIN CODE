    def create_smooth_profiles(self):
        """Interpolates hourly data to create smooth, minute-by-minute curves."""
        hourly_times = np.arange(25)
        self.minute_times = np.linspace(0, 24, 24 * 60, endpoint=False)
        
        home_load_hourly = [0.8,0.6,0.5,0.5,0.6,0.8,1.2,1.5,1.8,2.0,2.5,3.0,3.5,3.2,3.0,2.8,2.5,2.8,3.5,3.0,2.5,2.0,1.5,1.0, 0.8]
        solar_hourly = np.array([0,0,0,0,0,0.1,0.8,2.0,4.5,6.0,8.0,10.0,9.5,8.0,6.0,4.0,2.0,0.5,0,0,0,0,0,0, 0]) * 5.0
        
        self.home_load_profile = np.interp(self.minute_times, hourly_times, home_load_hourly)
        self.solar_profile = np.interp(self.minute_times, hourly_times, solar_hourly)

