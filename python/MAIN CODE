    # --- Route Adviser Functions ---
    
    def start_route_adviser_check(self):
        """Validates inputs and starts the route check in a thread."""
        start_loc = self.route_start_entry.get()
        end_loc = self.route_end_entry.get()
        try:
            start_soc = float(self.route_soc_entry.get())
        except ValueError:
            self.route_status_var.set("Error: Starting SOC must be a number.")
            return

        if not start_loc or not end_loc:
            self.route_status_var.set("Error: Start and End locations are required.")
            return

        self.route_status_var.set("Checking route... Fetching coordinates...")
        self.route_check_button.config(state=tk.DISABLED)

        threading.Thread(target=self.route_adviser_thread, 
                         args=(start_loc, end_loc, start_soc), 
                         daemon=True).start()

    def route_adviser_thread(self, start_loc, end_loc, start_soc):
        """(Worker Thread) Fetches route distance and updates UI."""
        try:
            # --- 1. Get Geocodes for Start/End ---
            start_coords = self.get_ors_coords(start_loc)
            end_coords = self.get_ors_coords(end_loc)
            
            if not start_coords or not end_coords:
                self.root.after(0, self.route_status_var.set, "Error: Could not find locations. Be more specific.")
                # --- FIX: Use lambda to correctly pass arguments to after() ---
                self.root.after(0, lambda: self.route_check_button.config(state=tk.NORMAL))
                return

            # --- 2. Get Route Distance from OpenRouteService ---
            self.root.after(0, self.route_status_var.set, "Calculating route from OpenRouteService...")
            
            total_distance_km = self.get_ors_route_distance(start_coords, end_coords)
            if total_distance_km is None:
                self.root.after(0, self.route_status_var.set, "Error: Could not calculate route.")
                # --- FIX: Use lambda to correctly pass arguments to after() ---
                self.root.after(0, lambda: self.route_check_button.config(state=tk.NORMAL))
                return
                
            current_range_km = (start_soc / 100) * self.ev_max_range_km
            
            # --- 3. Update UI (on main thread) ---
            result_message = f"Total Distance: {total_distance_km:.1f} km.\n"
            result_message += f"Your Current Range: {current_range_km:.1f} km.\n\n"
            
            if total_distance_km > (current_range_km - self.fixed_buffer_km): # Include buffer in check
                needed = total_distance_km + self.fixed_buffer_km
                result_message += f"ADVICE: You will need to charge. You need ~{needed:.1f} km of range (including buffer)."
            else:
                result_message += "ADVICE: You have enough range to make this trip!"

            self.root.after(0, self.route_status_var.set, result_message)
            # --- FIX: Use lambda to correctly pass arguments to after() ---
            self.root.after(0, lambda: self.route_check_button.config(state=tk.NORMAL))

            # --- ADDED: Send notification to the trip topic ---
            alert_title = f"EV Route: {start_loc} to {end_loc}"
            self.send_alert(alert_title, result_message, topic=self.trip_notification_topic)
            # --- End of notification ---

        except Exception as e:
            self.root.after(0, self.route_status_var.set, f"An error occurred: {e}")
            # --- FIX: Use lambda to correctly pass arguments to after() ---
            self.root.after(0, lambda: self.route_check_button.config(state=tk.NORMAL))
            
    def get_ors_route_distance(self, start_coords, end_coords):
        """Uses OpenRouteService to get route distance (in km)."""
        try:
            headers = {
                'Authorization': self.openrouteservice_api_key,
                'Content-Type': 'application/json'
            }
            # Note: ORS expects [lon, lat] format
            body = { "coordinates": [start_coords, end_coords] }
            url = "https://api.openrouteservice.org/v2/directions/driving-car"
            
            response = requests.post(url, headers=headers, json=body)
            response.raise_for_status()
            data = response.json()
            
            # Extract distance (in meters) and convert to km
            distance_km = data['routes'][0]['summary']['distance'] / 1000.0
            return distance_km
            
        except Exception as e:
            print(f"ORS Route Distance Error: {e}")
            return None

