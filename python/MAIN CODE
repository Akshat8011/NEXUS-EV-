            ax.grid(True, linestyle='--'); ax.set_xlim(0, 24)
        self.ax_soc.set_ylim(-5, 105)
        self.ax_power_contrib.set_ylim(0, 10)
        self.ax_power_contrib.set_yticks(np.arange(0, 11, 2))
        
        self.canvas_analytics = FigureCanvasTkAgg(self.fig, master=parent)
        self.canvas_analytics.get_tk_widget().pack(fill=tk.BOTH, expand=True)

    def reset_simulation_state(self):
        """Resets all simulation variables to their initial state."""
        self.is_running = False; self.grid_is_down = False; self.time_step = 0
        self.last_alert_mode = "" # Reset alert spam protector
        
        self.ev_soc, self.home_battery_soc = 80.0, 50.0
        self.is_ev_plugged_in = True # Reset to plugged in
        
        self.total_cost, self.total_earnings = 0.0, 0.0
        
        self.plot_time, self.ev_soc_data, self.home_battery_soc_data = [], [], []
        self.grid_net_data, self.solar_to_house_data, self.ev_to_house_data, self.grid_to_house_data = [], [], [], []
        
        self.ev_soc_line.set_data([], []); self.home_battery_soc_line.set_data([], []); self.grid_net_line.set_data([], [])
        self.solar_contrib_line.set_data([], []); self.ev_contrib_line.set_data([], []); self.grid_contrib_line.set_data([], [])
        self.canvas_analytics.draw()

        self.draw_diagram_elements()
        self.start_button.config(state="normal")
        self.pause_button.config(state=tk.DISABLED)
        self.resume_button.config(state=tk.DISABLED)
        
        self.grid_status_label.config(foreground="lightgreen"); self.grid_status_var.set("Grid: CONNECTED")
        self.update_dashboard(0, "Ready")
        self.update_min_range_label(self.min_range_slider.get())

    def start_simulation(self):
        if self.is_running: return
        self.reset_simulation_state()
        self.is_running = True
        self.start_button.config(state=tk.DISABLED)
        self.pause_button.config(state=tk.NORMAL)
        self.resume_button.config(state=tk.DISABLED)
        self.root.after(10, self.update_loop)

    def pause_sim(self):
        """Pauses the simulation."""
        if not self.is_running: return
        self.is_running = False
        self.pause_button.config(state=tk.DISABLED)
        self.resume_button.config(state=tk.NORMAL)

    def resume_sim(self):
        """Resumes the simulation."""
        if self.is_running: return
        self.is_running = True
        self.pause_button.config(state=tk.NORMAL)
        self.resume_button.config(state=tk.DISABLED)
        self.update_loop() # Restart the loop

    def simulate_grid_failure(self): 
        if self.grid_is_down: return # Don't send alert if already down
        self.grid_is_down = True
        self.send_alert("GRID FAILURE", "Grid power is offline! Switching to battery/solar.")
        self.last_alert_mode = "Grid Failure"

    def restore_grid(self): 
        self.grid_is_down = False
        self.send_alert("GRID RESTORED", "Grid power is back online.")
        self.last_alert_mode = "Grid Restored"
        
    def simulation_finished(self):
        """Called when the simulation loop finishes."""
        self.is_running = False
        self.start_button.config(state="normal")
        self.pause_button.config(state=tk.DISABLED)
        self.resume_button.config(state=tk.DISABLED)
        self.send_alert("Simulation Complete", f"24-hour day finished. Net Profit/Loss: ₹{self.total_earnings - self.total_cost:.2f}")


    def update_loop(self):
        if not self.is_running:
            if self.time_step >= 24 * 60:
                self.simulation_finished()
            return
        
        if self.time_step >= 24 * 60:
            self.simulation_finished()
            return

        total_seconds = self.time_step * 60
        minute_of_day = self.time_step
        hour = minute_of_day // 60
        interval_h = 1 / 60.0
        
        solar_power = self.solar_profile[minute_of_day]
        home_load = self.home_load_profile[minute_of_day]
        
        charger_mode = "Idle"
        net_ev_power, net_home_battery_power, grid_power = 0, 0, 0
        flows = {k: 0 for k in self.animation_paths.keys()}
        
        power_needed_by_house = home_load
        from_solar = min(power_needed_by_house, solar_power)
        flows["solar_house"] = from_solar
        power_needed_by_house -= from_solar
        
        if power_needed_by_house > 0 and self.home_battery_soc > 1:
            from_batt = min(power_needed_by_house, self.home_battery_capacity_kwh * 0.5)
            net_home_battery_power = -from_batt
            flows["battery_house"] = from_batt
            power_needed_by_house -= from_batt
        
        required_range_km = self.min_range_slider.get() + self.fixed_buffer_km
        required_soc = (required_range_km / self.ev_max_range_km) * 100
        
        # --- MODIFIED: Simulation logic now respects plug state ---
        
        # 1. Driving logic overrides all plug states
        if 8 <= hour < 9:
            commute_kwh_per_hour = (30 / self.ev_max_range_km) * self.ev_capacity_kwh # 30km = 6%
            net_ev_power = -commute_kwh_per_hour
            charger_mode = "Driving (Commute)"
            self.is_ev_plugged_in = False # Force unplug
        
        elif 17 <= hour < 18:
            commute_kwh_per_hour = (30 / self.ev_max_range_km) * self.ev_capacity_kwh # 30km = 6%
            net_ev_power = -commute_kwh_per_hour
            charger_mode = "Driving (Home)"
            self.is_ev_plugged_in = False # Force unplug
            
        # 2. Arriving home, default to plugged in (user can override)
        elif hour == 18 and minute_of_day == 18*60:
            self.is_ev_plugged_in = True 
            charger_mode = "Plugged In (Idle)"
        
        # 3. At office (not at home, so plug state doesn't matter)
        elif 11 <= hour < 17 and not self.grid_is_down:
            self.is_ev_plugged_in = False # Not plugged in *at home*
            if self.ev_soc > required_soc + 1:
                charger_mode = "V2G @ Office" # Set mode first
                surplus_soc = self.ev_soc - required_soc
                surplus_kwh = (surplus_soc / 100) * self.ev_capacity_kwh
                max_discharge_power_for_interval = surplus_kwh / interval_h
                discharge_power = min(self.v2g_rate_kw, max_discharge_power_for_interval)
                net_ev_power = -discharge_power
                flows["ev_grid"] = discharge_power
                grid_power -= discharge_power
        
        # 4. At home, and user has EV plugged in
        elif self.is_ev_plugged_in:
            if self.grid_is_down:
                is_total_blackout = self.home_battery_soc <= 1 and solar_power < 0.1
                if is_total_blackout:
                    if self.ev_soc > required_soc and power_needed_by_house > 0:
                        charger_mode = "EMERGENCY V2H"
                        surplus_soc = self.ev_soc - required_soc
                        surplus_kwh = (surplus_soc / 100) * self.ev_capacity_kwh
                        max_discharge_power_for_interval = surplus_kwh / interval_h
                        from_ev = min(power_needed_by_house, self.v2g_rate_kw, max_discharge_power_for_interval)
                        
                        net_ev_power = -from_ev
                        flows["ev_house"] = from_ev
                        power_needed_by_house -= from_ev
                    
                    if power_needed_by_house > 0:
                        charger_mode = "BLACKOUT"
                else:
                    charger_mode = "Grid Down (Batt OK)"
            
            else: # Grid is ON
                if power_needed_by_house > 0:
                    grid_power += power_needed_by_house
                    flows["grid_house"] = power_needed_by_house
                
                # Night Charging
                if 21 <= hour or hour < 5:
                    if self.ev_soc < 100:
                        net_ev_power = self.charge_rate_kw
                        charger_mode = "Night Charging"
                        flows["grid_ev"] = self.charge_rate_kw
                        grid_power += self.charge_rate_kw
                
            # Solar Charging (can happen anytime if grid is up or down)
            surplus_solar = solar_power - flows["solar_house"]
            if surplus_solar > 0:
                if self.home_battery_soc < 100:
                    to_batt = min(surplus_solar, self.home_battery_capacity_kwh * 0.5)
                    net_home_battery_power += to_batt
                    flows["solar_battery"] = to_batt
                    surplus_solar -= to_batt
                if surplus_solar > 0:
                    to_ev = min(surplus_solar, self.charge_rate_kw)
                    net_ev_power += to_ev
                    flows["solar_ev"] = to_ev
                    charger_mode = "Solar Charging"

        # 5. At home, but user has EV unplugged
        else:
            charger_mode = "Idle (Unplugged)"
            net_ev_power = 0
            if not self.grid_is_down and power_needed_by_house > 0:
                grid_power += power_needed_by_house
                flows["grid_house"] = power_needed_by_house
            # Handle solar when EV is unplugged
            surplus_solar = solar_power - flows["solar_house"]
            if surplus_solar > 0:
                if self.home_battery_soc < 100:
                    to_batt = min(surplus_solar, self.home_battery_capacity_kwh * 0.5)
                    net_home_battery_power += to_batt
                    flows["solar_battery"] = to_batt
                    surplus_solar -= to_batt
                # Any remaining solar is just "lost" or "exported" (not tracked)

        # --- End of MODIFIED logic ---

        # --- Phone Alerting Logic (All Modes) ---
        if charger_mode != self.last_alert_mode:
            alert_title = f"EV Hub: {charger_mode}"
            alert_message = ""

            if "Driving" in charger_mode:
                alert_message = f"EV is now driving. SOC is {self.ev_soc:.1f}%."
            elif "Charging" in charger_mode:
                alert_message = f"EV started charging. SOC is {self.ev_soc:.1f}%."
            elif "V2G" in charger_mode:
                alert_message = f"Selling power to grid. SOC is {self.ev_soc:.1f}%."
            elif "V2H" in charger_mode:
                alert_title = "⚠️ EMERGENCY V2H ⚠️"
                alert_message = f"Powering house from EV! SOC is {self.ev_soc:.1f}%."
                print("DEBUG: V2H Alert Triggered. Sending notification...")
            elif "BLACKOUT" in charger_mode:
                alert_title = "🚨 POWER BLACKOUT 🚨"
                alert_message = "Grid is down and home battery is empty. House is offline."
            elif "Idle" in charger_mode:
                alert_message = f"EV is {charger_mode}. SOC is {self.ev_soc:.1f}%."
            
            if alert_message: # Only send if we have a custom message
                self.send_alert(alert_title, alert_message)
            
            self.last_alert_mode = charger_mode
            
        # --- End of Alerting Logic ---

        self.ev_soc = np.clip(self.ev_soc + (net_ev_power * interval_h / self.ev_capacity_kwh) * 100, 0, 100)
        self.home_battery_soc = np.clip(self.home_battery_soc + (net_home_battery_power * interval_h / self.home_battery_capacity_kwh) * 100, 0, 100)
        
        if grid_power > 0: self.total_cost += grid_power * interval_h * self.residential_rate
        elif grid_power < 0: self.total_earnings += abs(grid_power) * interval_h * self.commercial_rate

        self.update_dashboard(total_seconds, charger_mode)
        self.update_power_flow_diagram(grid_power, solar_power, home_load, net_ev_power, net_home_battery_power, flows)
        
        current_time_hours = total_seconds / 3600.0
        self.plot_time.append(current_time_hours); self.ev_soc_data.append(self.ev_soc); self.home_battery_soc_data.append(self.home_battery_soc); self.grid_net_data.append(grid_power)
        self.solar_to_house_data.append(flows["solar_house"]); self.ev_to_house_data.append(flows["ev_house"]); self.grid_to_house_data.append(flows["grid_house"])
        self.update_analytics_plots()

        self.time_step += 1
        self.root.after(111, self.update_loop)

    def update_dashboard(self, total_seconds, mode):
        # --- BUG FIX: Changed div_mod to divmod ---
        hour, minute = divmod(int(total_seconds / 60), 60)
        
        self.time_var.set(f"{hour:02}:{minute:02}")
        self.mode_var.set(f"Mode: {mode}")
        self.soc_text_var.set(f"EV SOC: {self.ev_soc:.1f}%")
        self.range_text_var.set(f"Range: {self.ev_soc / 100 * self.ev_max_range_km:.1f} km")
        self.soc_progress['value'] = self.ev_soc
        self.grid_status_var.set("Grid: OFFLINE" if self.grid_is_down else "Grid: CONNECTED")
        self.grid_status_label.config(foreground="#BF616A" if self.grid_is_down else "lightgreen")
        
        net_profit = (self.total_earnings) - self.total_cost
        self.net_var.set(f"Net {'Profit' if net_profit >= 0 else 'Loss'}: ₹{abs(net_profit):.2f}")
        
        if "BLACKOUT" in mode: self.mode_label.config(foreground="red")
        elif "V2H" in mode or "Support" in mode: self.mode_label.config(foreground="orange")
        elif "Driving" in mode: self.mode_label.config(foreground="#EBCB8B")
        else:
            self.mode_label.config(foreground="#5294E2") # Bright blue
            
        # --- NEW: Update Plug Status Label Color ---
        if self.is_ev_plugged_in:
            self.plug_status_var.set("EV: Plugged In")
            self.plug_status_label.config(foreground="lightgreen")
        else:
            self.plug_status_var.set("EV: Unplugged")
            self.plug_status_label.config(foreground="#BF616A") # Red

        # --- NEW: Throttled Status Notification ---
        current_time = time.time()
        if self.is_running and (current_time - self.last_status_send_time > 10): # Send every 10 seconds, only if sim is running
            self.last_status_send_time = current_time
            range_km = self.ev_soc / 100 * self.ev_max_range_km
            status_message = f"SOC: {self.ev_soc:.1f}% | Range: {range_km:.1f} km | Mode: {mode}"
            # Send to the *status* topic
            self.send_alert("EV Status", status_message, topic=self.status_notification_topic)

    def update_power_flow_diagram(self, grid, solar, house, ev, battery, flows):
        if not hasattr(self, 'coords'): return
        self.canvas.itemconfig(self.power_labels["grid"], text=f"{abs(grid):.1f} kW")
        self.canvas.itemconfig(self.power_labels["solar"], text=f"{solar:.1f} kW")
        self.canvas.itemconfig(self.power_labels["house"], text=f"{house:.1f} kW")
        self.canvas.itemconfig(self.power_labels["ev"], text=f"{abs(ev):.1f} kW")
        self.canvas.itemconfig(self.power_labels["battery"], text=f"{abs(battery):.1f} kW")
        self.canvas.itemconfig(self.ev_soc_label, text=f"SOC: {self.ev_soc:.1f}%")
        self.canvas.itemconfig(self.battery_soc_label, text=f"SOC: {self.home_battery_soc:.1f}%")
        self.canvas.itemconfig("grid_icon", fill="#5e636e" if self.grid_is_down else "#BF616A")
        
        for key, spark_list in self.animated_sparks.items():
            for spark_id in spark_list: self.canvas.delete(spark_id)
        self.animated_sparks.clear()
        
        colors = {"solar_house": "gold", "solar_ev": "gold", "solar_battery": "gold",
                  "grid_house": "#e60000", "grid_ev": "#e60000",
                  "ev_house": "lightblue", "ev_grid": "lightgreen", "battery_house": "cyan"}
        
        self.animation_offset = (self.animation_offset + self.animation_speed) % 100
        
        for key, power in flows.items():
            if power > 0.1 and key in self.animation_paths:
                path = self.animation_paths[key]
                dx, dy = path[1][0] - path[0][0], path[1][1] - path[0][1]
                num_sparks = max(1, int(power / 2))
                
                sparks = []
                for i in range(num_sparks):
                    pos = (self.animation_offset + i * (100 // num_sparks)) % 100 / 100.0
                    x, y = path[0][0] + dx * pos, path[0][1] + dy * pos
                    spark_id = self.canvas.create_oval(x-4, y-4, x+4, y+4, fill=colors.get(key, "white"), outline="")
                    sparks.append(spark_id)
                self.animated_sparks[key] = sparks
        
        # --- MODIFIED: Outline reflects plug state ---
        if not self.is_ev_plugged_in:
            self.canvas.itemconfig(self.ev_oval, outline="grey", width=2) # Grey if unplugged
        elif ev > 0.1: 
            self.canvas.itemconfig(self.ev_oval, outline="gold", width=4) # Charging
        elif ev < -0.1: 
            self.canvas.itemconfig(self.ev_oval, outline="red", width=4) # Discharging
        else: 
            self.canvas.itemconfig(self.ev_oval, outline="white", width=2) # Plugged in, idle
            
        self.canvas.update()

    def update_analytics_plots(self):
        self.ev_soc_line.set_data(self.plot_time, self.ev_soc_data)
        self.home_battery_soc_line.set_data(self.plot_time, self.home_battery_soc_data)
        self.grid_net_line.set_data(self.plot_time, self.grid_net_data)
        
        self.solar_contrib_line.set_data(self.plot_time, self.solar_to_house_data)
        self.ev_contrib_line.set_data(self.plot_time, self.ev_to_house_data)
        self.grid_contrib_line.set_data(self.plot_time, self.grid_to_house_data)

        for ax in self.fig.axes:
            ax.relim()
            ax.autoscale_view()
        self.ax_soc.set_ylim(-5, 105)
        self.ax_power_contrib.set_ylim(bottom=0, top=10)
        
        self.fig.canvas.draw_idle()

