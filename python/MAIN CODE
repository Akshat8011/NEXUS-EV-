    # --- Weather Functions ---
    def start_weather_fetch(self):
        """Starts fetching weather data in a separate thread."""
        weather_thread = threading.Thread(target=self.fetch_weather_data, daemon=True)
        weather_thread.start()

    def fetch_weather_data(self):
        """Fetches current weather, forecast, and AQI from OpenWeatherMap."""
        
        while True: # Run continuously in the background
            try:
                # 1. Fetch Current Weather
                current_url = f"https://api.openweathermap.org/data/2.5/weather?lat={self.city_lat}&lon={self.city_lon}&appid={self.weather_api_key}&units=metric"
                current_response = requests.get(current_url)
                current_response.raise_for_status() # Raises an error for bad responses
                self.weather_data['current'] = current_response.json()
                
                # 2. Fetch 5-Day Forecast
                forecast_url = f"https://api.openweathermap.org/data/2.5/forecast?lat={self.city_lat}&lon={self.city_lon}&appid={self.weather_api_key}&units=metric"
                forecast_response = requests.get(forecast_url)
                forecast_response.raise_for_status()
                self.weather_data['forecast'] = forecast_response.json()
                
                # 3. Fetch Air Pollution (AQI)
                air_url = f"https://api.openweathermap.org/data/2.5/air_pollution?lat={self.city_lat}&lon={self.city_lon}&appid={self.weather_api_key}"
                air_response = requests.get(air_url)
                air_response.raise_for_status()
                self.weather_data['air_pollution'] = air_response.json()

                # 4. Schedule UI update on the main thread
                self.root.after(0, self.update_weather_display)
                
                # Wait 10 minutes before the next refresh
                time.sleep(600) # (10 minutes * 60 seconds)
                
            except requests.RequestException as e:
                # Handle API errors gracefully in the UI
                self.root.after(0, self.show_weather_error, str(e))
                # If an error occurs, wait 5 minutes before retrying
                time.sleep(300)

    def update_weather_display(self):
        """Updates the Tkinter labels with the fetched weather data."""
        try:
            # Update Current Weather
            current = self.weather_data.get('current')
            if current:
                description = current['weather'][0]['main']
                temp = current['main']['temp']
                visibility_m = current.get('visibility', 10000)
                visibility_km = visibility_m / 1000.0

                if description == "Clear":
                    uv_index = 3
                elif description in ["Clouds", "Haze", "Fog", "Mist"]:
                    uv_index = 2
                elif description in ["Rain", "Drizzle", "Thunderstorm", "Snow"]:
                    uv_index = 1
                else:
                    uv_index = 2

                self.weather_desc_var.set(f"{description}")
                self.weather_temp_var.set(f"{temp:.1f}°C")
                self.weather_vis_var.set(f"Vis: {visibility_km:.1f} km")
                self.weather_uv_var.set(f"UV Index: {uv_index} (Est.)")
            else:
                self.show_weather_error("No current data.")
                return # Don't proceed if current data failed

            # Update AQI (PM2.5)
            air_data = self.weather_data.get('air_pollution')
            if air_data and air_data.get('list'):
                pm2_5 = air_data['list'][0]['components'].get('pm2_5', 0)
                self.weather_aqi_var.set(f"PM2.5: {pm2_5:.1f} µg/m³")
                
                # Set color based on PM2.5 value
                if pm2_5 > 155:
                    self.aqi_label.config(foreground="#FF5555") # Bright Red
                elif 80 <= pm2_5 <= 155:
                    self.aqi_label.config(foreground="#FFFF66") # Bright Yellow
                else: # < 80
                    self.aqi_label.config(foreground="#66FF66") # Bright Green
            else:
                self.weather_aqi_var.set("PM2.5: N/A")
                self.aqi_label.config(foreground="white")

            # Enable the forecast button
            if self.weather_data.get('forecast'):
                self.forecast_button.config(state=tk.NORMAL)
                
        except Exception as e:
            self.show_weather_error(f"Parse error: {e}")
            if hasattr(self, 'aqi_label'):
                self.weather_aqi_var.set("PM2.5: Error")
                self.aqi_label.config(foreground="white")


    def show_weather_error(self, error_msg):
        """Displays an error message in the weather panel."""
        self.weather_desc_var.set("Weather Error")
        self.weather_temp_var.set(error_msg)
        self.weather_vis_var.set("")
        self.weather_uv_var.set("")
        self.forecast_button.config(state=tk.DISABLED)
        # Also reset AQI label
        if hasattr(self, 'aqi_label'):
            self.weather_aqi_var.set("PM2.5: Error")
            self.aqi_label.config(foreground="white")

    def show_forecast_window(self):
        """Creates a new Toplevel window to display the 5-day forecast."""
        forecast_data = self.weather_data.get('forecast')
        if not forecast_data:
            return

        forecast_win = Toplevel(self.root)
        forecast_win.title("5-Day Weather Forecast (Lucknow)")
        forecast_win.geometry("350x400")
        forecast_win.configure(bg="#3B4252")
        
        ttk.Label(forecast_win, text="5-Day Forecast (12:00 PM)", font=("Helvetica", 16, "bold")).pack(pady=10)
        
        daily_forecasts = []
        for item in forecast_data['list']:
            if "12:00:00" in item['dt_txt']:
                daily_forecasts.append(item)
        
        if not daily_forecasts: # Fallback if no 12:00 PM data
            unique_days = {}
            for item in forecast_data['list']:
                day = item['dt_txt'].split(' ')[0]
                if day not in unique_days:
                    unique_days[day] = item
            daily_forecasts = list(unique_days.values())[1:6]

        for item in daily_forecasts:
            try:
                dt_obj = datetime.strptime(item['dt_txt'], '%Y-%m-%d %H:%M:%S')
                day_name = dt_obj.strftime('%A (%d %b)')
                temp = item['main']['temp']
                desc = item['weather'][0]['description'].title()
                
                frame = ttk.Frame(forecast_win, padding=5, style='TFrame')
                frame.pack(fill=tk.X, padx=10, pady=2)
                
                ttk.Label(frame, text=day_name, font=("Helvetica", 12, "bold"), anchor="w").pack(fill=tk.X)
                ttk.Label(frame, text=f"{temp:.1f}°C, {desc}", font=("Helvetica", 10), anchor="w").pack(fill=tk.X)
            except Exception:
                continue

    # --- Notification Functions ---
    def send_alert(self, title, message, topic=None):
        """Sends phone notifications in a separate thread.
        Can optionally specify a different topic."""
        threading.Thread(target=self._send_alert_thread, args=(title, message, topic), daemon=True).start()

    def _send_alert_thread(self, title, message, topic):
        """Internal function that runs in a thread to send alerts."""
        
        # Use the provided topic, or default to the main one
        if topic is None:
            target_topic = self.phone_notification_topic
        else:
            target_topic = topic

        # Phone Notification (ntfy.sh)
        if "your-secret-ntfy-topic" in target_topic: # Check for default
            print(f"Notification topic '{target_topic}' not set. Skipping phone alert.")
            return 
        try:
            requests.post(
                f"https://ntfy.sh/{target_topic}",
                data=message.encode('utf-8'), # Encode for reliability
                headers={"Title": title}
            )
        except Exception as e:
            # Non-critical, just log to console
            print(f"Phone notification failed: {e}")

    # --- NEW: Remote Control Functions ---
    
    def start_command_listener(self):
        """Starts the ntfy.sh command listener in a separate thread."""
        print(f"Starting command listener on topic: {self.command_notification_topic}")
        listener_thread = threading.Thread(target=self.listen_for_commands, daemon=True)
        listener_thread.start()

    def listen_for_commands(self):
        """(Worker Thread) Listens for commands from ntfy.sh."""
        while True:
            try:
                # Use a streaming GET request to listen for new messages
                response = requests.get(
                    f"https://ntfy.sh/{self.command_notification_topic}/json",
                    stream=True,
                    timeout=None # Listen forever
                )
                print("Command listener connected.")
                for line in response.iter_lines():
                    if line:
                        try:
                            # Parse the JSON event stream
                            data = json.loads(line.decode('utf-8'))
                            if data.get('event') == 'message':
                                command = data.get('message', '').strip().lower()
                                
                                # --- UPDATED: List of all valid commands ---
                                valid_commands = [
                                    "plug", "unplug", "send soc", "send range", 
                                    "honk", "flash lights", "get weather", 
                                    "get aqi", "party mode", "get home soc"
                                ]

                                if command in valid_commands:
                                    print(f"Received command: {command}")
                                    # Safely pass the command to the main thread
                                    self.root.after(0, self.process_command, command)
                        except json.JSONDecodeError:
                            continue # Ignore invalid JSON
            except requests.RequestException as e:
                print(f"Command listener error: {e}. Reconnecting in 5s...")
                time.sleep(5) # Wait before retrying

    def process_command(self, command):
        """(Main Thread) Processes commands received from the listener."""
        if command == "plug":
            self.is_ev_plugged_in = True
            # self.plug_status_var.set("EV: Plugged In") # update_dashboard handles this
            # self.plug_status_label.config(foreground="lightgreen")
            self.send_alert("EV Remote Control", "EV has been plugged in remotely.", topic=self.phone_notification_topic)
        
        elif command == "unplug":
            self.is_ev_plugged_in = False
            # self.plug_status_var.set("EV: Unplugged") # update_dashboard handles this
            # self.plug_status_label.config(foreground="#BF616A") # Red
            self.send_alert("EV Remote Control", "EV has been unplugged remotely.", topic=self.phone_notification_topic)
        
        elif command == "send soc":
            self.send_manual_status("soc")
        
        elif command == "send range":
            self.send_manual_status("range")
        
        # --- NEW: Get Home SOC ---
        elif command == "get home soc":
            self.send_manual_status("home_soc")

        # --- NEW: Weather/AQI Commands ---
        elif command == "get weather":
            self.send_manual_status("weather")
        
        elif command == "get aqi":
            self.send_manual_status("aqi")

        # --- NEW: Fun Commands ---
        elif command == "honk":
            self.send_alert("EV Remote Control", "Honk Honk!", topic=self.phone_notification_topic)
            self.root.bell() # Play system alert sound
            self.flash_ev_icon()

        elif command == "flash lights":
            self.send_alert("EV Remote Control", "Flashing lights!", topic=self.phone_notification_topic)
            self.root.bell() # Play system alert sound
            self.flash_ev_icon()
        
