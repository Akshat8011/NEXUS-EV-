    def start_find_chargers_check(self):
        """Validates input and starts the charger search in a thread."""
        location_name = self.find_loc_entry.get()
        if not location_name:
            self.find_status_var.set("Error: Location name is required.")
            return

        self.find_status_var.set(f"Finding chargers near {location_name}...")
        self.find_chargers_button.config(state=tk.DISABLED)
        # Clear previous results
        for item in self.find_charger_treeview.get_children():
            self.find_charger_treeview.delete(item)

        threading.Thread(target=self.find_chargers_thread, 
                         args=(location_name,), 
                         daemon=True).start()

    def find_chargers_thread(self, location_name):
        """(Worker Thread) Fetches coordinates, then chargers, and updates UI."""
        try:
            # --- 1. Get Geocode for Location ---
            self.root.after(0, self.find_status_var.set, f"Finding coordinates for {location_name}...")
            coords = self.get_ors_coords(location_name)
            
            if not coords:
                self.root.after(0, self.find_status_var.set, "Error: Could not find location. Be more specific.")
                # --- FIX: Use lambda to correctly pass arguments to after() ---
                self.root.after(0, lambda: self.find_chargers_button.config(state=tk.NORMAL))
                return

            # ORS gives [lon, lat], OCM needs (lat, lon)
            lon, lat = coords[0], coords[1]
            
            # --- 2. Get Chargers from OpenChargeMap ---
            self.root.after(0, self.find_status_var.set, "Finding chargers from OpenChargeMap...")
            charger_list = self.get_ocm_chargers_by_coords(lat, lon)
            
            # --- ADDED: Send notification with charger list ---
            alert_title_chg = f"Chargers Near {location_name}"
            alert_message_chg = ""
            if not charger_list:
                alert_message_chg = f"No chargers found within 25km of {location_name}."
            else:
                alert_message_chg = f"Found {len(charger_list)} chargers. Top 5 nearby:\n"
                # Sort by title to be consistent
                charger_list.sort(key=lambda x: x.get('Title', ''))
                for charger in charger_list[:5]: # Get first 5
                    title = charger.get("Title", "Unknown")
                    # --- MODIFIED: Add speed and availability to notification ---
                    speed = charger.get("Speed", "--")
                    available = charger.get("Available", "0 of 0")
                    alert_message_chg += f"- {title} ({speed}kW, {available} free)\n"
            
            self.send_alert(alert_title_chg, alert_message_chg, topic=self.trip_notification_topic)
            # --- End of notification ---

            # --- 3. Update UI (on main thread) ---
            self.root.after(0, self.update_nearby_chargers_list, charger_list)

        except Exception as e:
            self.root.after(0, self.find_status_var.set, f"An error occurred: {e}")
            # --- FIX: Use lambda to correctly pass arguments to after() ---
            self.root.after(0, lambda: self.find_chargers_button.config(state=tk.NORMAL))

    def update_nearby_chargers_list(self, charger_list):
        """(Main Thread) Updates the charger treeview with results."""
        self.find_chargers_button.config(state=tk.NORMAL)
        
        # Clear old results
        for item in self.find_charger_treeview.get_children():
            self.find_charger_treeview.delete(item)
            
        if not charger_list:
            self.find_status_var.set("No chargers found within 25km of that location.")
            self.find_charger_treeview.insert("", tk.END, values=("No chargers found.", ""))
            return

        self.find_status_var.set(f"Found {len(charger_list)} chargers near {self.find_loc_entry.get()}.")
        
        charger_list.sort(key=lambda x: x.get('Title', ''))
        for charger in charger_list:
            title = charger.get("Title", "Unknown Charger")
            address = charger.get("Address", "No address")
            # --- ADDED: Get new data for the list ---
            speed = charger.get("Speed", "--")
            available = charger.get("Available", "--")
            # --- MODIFIED: Insert all 4 values ---
            self.find_charger_treeview.insert("", tk.END, values=(title, address, speed, available))

    def get_ocm_chargers_by_coords(self, lat, lon):
        """Uses OpenChargeMap to get chargers near a specific lat/lon."""
        try:
            base_url = "https://api.openchargemap.io/v3/poi/"
            params = {
                'key': self.openchargemap_api_key,
                'output': 'json',
                'latitude': lat,
                'longitude': lon,
                'distance': 25, # 25km radius
                'distanceunit': 'km',
                'maxresults': 50,
                'includecomments': 'false',
                'verbose': 'false'
            }
            
            response = requests.get(base_url, params=params)
            response.raise_for_status()
            data = response.json()
            
            if data and isinstance(data, list):
                chargers = []
                for item in data:
                    # --- ADDED: Generate Mock Data as requested ---
                    # 3x 22kW, 1x 60kW, 1x 80kW -> 2/5 are fast
                    speed_kw = random.choice([22, 22, 22, 60, 80]) 
                    total_spots = random.randint(2, 8)
                    available_spots = random.randint(0, total_spots)
                    available_str = f"{available_spots} of {total_spots}"
                    # --- End Mock Data ---

                    chargers.append({
                        "ID": item['ID'],
                        "Title": item['AddressInfo']['Title'],
                        "Address": f"{item['AddressInfo'].get('AddressLine1', '')}, {item['AddressInfo'].get('Town', '')}",
                        # --- ADDED: New mock data fields ---
                        "Speed": speed_kw,
                        "Available": available_str
                    })
                return chargers
            return []
        except Exception as e:
            print(f"OCM Error: {e}")
            return []
            
    # --- Utility Geocoder ---
    
    def get_ors_coords(self, location_name):
        """Uses OpenRouteService Geocode to get (lon, lat) from a name."""
        try:
            url = f"https://api.openrouteservice.org/geocode/search?api_key={self.openrouteservice_api_key}&text={urllib.parse.quote(location_name)}&size=1"
            response = requests.get(url)
            response.raise_for_status()
            data = response.json()
            # Returns [longitude, latitude]
            return data['features'][0]['geometry']['coordinates']
        except Exception:
            return None
            
